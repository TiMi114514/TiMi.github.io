# RAGFlow gateway config. Copy to gateway/.env (never commit .env).

# Where the gateway listens (keep 127.0.0.1 — Tailscale Funnel / Nginx connect locally).
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8787

# Local RAGFlow API and a key for it. Use a dedicated key and rotate it if it ever leaks.
RAGFLOW_URL=http://127.0.0.1:9380
RAGFLOW_API_KEY=

# Websites allowed to call the gateway from a browser (comma separated).
ALLOWED_ORIGINS=https://timi114514.github.io,http://localhost:3000,http://127.0.0.1:4173,http://localhost:4173

# Only datasets listed here are reachable (comma separated ids), or * for all.
ALLOWED_DATASETS=*
# Only assistants whose name starts with this prefix are reachable.
CHAT_PREFIX=DQ · 

# Supabase project; chat requires a valid signed-in user's token.
SUPABASE_URL=https://wksdpsmxwybsmtjjipxa.supabase.co
SUPABASE_JWKS=
REQUIRE_LOGIN_FOR_CHAT=true

# Limits (per minute unless noted). Defaults are generous for normal students.
LIMIT_IP_PER_MIN=240
LIMIT_READ_PER_MIN=120
LIMIT_DOWNLOAD_PER_MIN=20
LIMIT_DOWNLOAD_PER_DAY=400
LIMIT_CHAT_PER_MIN=12
LIMIT_CHAT_PER_DAY=300
LIMIT_IP_CHAT_PER_MIN=30
CHAT_CONCURRENCY=3
BAN_AFTER_AUTH_FAILURES=30
BAN_MINUTES=30
LOG_RETENTION_DAYS=14