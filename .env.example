# ---- Supabase (Project Settings -> API) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ---- RAGFlow (browser-side connection) ----
# Base URL of your RAGFlow API server. Default is http://localhost:9380
NEXT_PUBLIC_RAGFLOW_BASE_URL=http://localhost:9380
# API key created in RAGFlow -> User settings -> API keys
NEXT_PUBLIC_RAGFLOW_API_KEY=ragflow-your-key
# Chat assistant id (RAGFlow -> Chat -> assistant -> URL contains chat_id)
NEXT_PUBLIC_RAGFLOW_CHAT_ID=
# Dataset (knowledge base) id(s), optional and comma separated. When set, the
# archive is read from RAGFlow.
NEXT_PUBLIC_RAGFLOW_DATASET_ID=

# ---- GitHub Pages ----
# Empty for user sites / custom domains. For project sites use "/<repo-name>".
NEXT_PUBLIC_BASE_PATH=
